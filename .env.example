# Copy to .env and fill in. Never commit the real .env.

# Shared HS256 signing secret (>= 32 bytes). Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
JWT_TTL=PT2H

# Shared key for service-to-service /internal calls. Generate: openssl rand -hex 32
INTERNAL_API_KEY=change-me-internal-key

# Postgres (local docker-compose or RDS)
DB_USERNAME=tickettide
DB_PASSWORD=tickettide

# First admin account, created on auth-service startup if it does not exist
BOOTSTRAP_ADMIN_EMAIL=admin@tickettide.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# S3 for event images. Locally this points at LocalStack.
AWS_REGION=us-east-1
S3_BUCKET=tickettide-event-media
S3_ENDPOINT=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# How long an unpaid order holds seats
ORDER_HOLD_DURATION=PT10M
